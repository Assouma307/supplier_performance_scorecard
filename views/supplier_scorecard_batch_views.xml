<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supplier_scorecard_batch_wizard_form" model="ir.ui.view">
        <field name="name">supplier.performance.scorecard.batch.wizard.form</field>
        <field name="model">supplier.performance.scorecard.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Supplier Scorecards">
                <group>
                    <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                    <field name="period_start"/><field name="period_end"/>
                    <field name="include_existing"/>
                </group>
                <footer><button name="action_generate" type="object" string="Generate Scorecards" class="oe_highlight"/><button string="Cancel" special="cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>
