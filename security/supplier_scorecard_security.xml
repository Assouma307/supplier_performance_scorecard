<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_supplier_scorecard_user" model="res.groups">
        <field name="name">Supplier Scorecard User</field>
    </record>
    <record id="group_supplier_scorecard_manager" model="res.groups">
        <field name="name">Supplier Scorecard Manager</field>
        <field name="implied_ids" eval="[(4, ref('supplier_performance_scorecard.group_supplier_scorecard_user'))]"/>
    </record>
    <record id="rule_supplier_scorecard_company" model="ir.rule">
        <field name="name">Supplier Scorecards : sociétés autorisées</field>
        <field name="model_id" ref="model_supplier_performance_scorecard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('supplier_performance_scorecard.group_supplier_scorecard_user'))]"/>
    </record>
    <record id="rule_supplier_evaluation_company" model="ir.rule">
        <field name="name">Supplier Evaluations: Allowed Companies</field>
        <field name="model_id" ref="model_supplier_performance_evaluation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('supplier_performance_scorecard.group_supplier_scorecard_user'))]"/>
    </record>
    <record id="rule_supplier_risk_event_company" model="ir.rule">
        <field name="name">Supplier Risk Alerts : sociétés autorisées</field>
        <field name="model_id" ref="model_supplier_performance_risk_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('supplier_performance_scorecard.group_supplier_scorecard_user'))]"/>
    </record>
</odoo>
